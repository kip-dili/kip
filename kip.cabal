cabal-version: 3.0
name:           kip
version:        0.1.0.0
description:    A programming language based on grammatical cases of Turkish.
homepage:       https://github.com/joom/kip#readme
bug-reports:    https://github.com/joom/kip/issues
author:         Joomy Korkut
maintainer:     joomy@type.systems
copyright:      2021 Joomy Korkut
license:        MIT
license-file:   LICENSE
build-type:     Simple
tested-with:    GHC == 9.14.1
extra-source-files:
    README.md
    vendor/trmorph.fst

data-files:
    vendor/trmorph.fst
    lib/temel.kip
    lib/giriş.kip
    lib/temel/doğruluk.kip
    lib/temel/karakter.kip
    lib/temel/dizge.kip
    lib/temel/etki.kip
    lib/temel/liste.kip
    lib/temel/küme.kip
    lib/temel/sözlük.kip
    lib/temel/tam-sayı.kip
    lib/temel/ondalık-sayı.kip

source-repository head
  type: git
  location: https://github.com/joom/kip

common kip-component
  default-language: Haskell2010
  ghc-options: -Werror=unused-imports -Werror=unused-local-binds -Werror=unused-matches -Werror=unused-packages -Werror=unused-top-binds
  if os(darwin)
    ghc-options: -optP-Wno-nonportable-include-path -optc-Wno-nonportable-include-path -optl-Wl,-w -optl-Wl,-dead_strip

library
  import: kip-component
  exposed-modules:
      Kip.AST
      Kip.Cache
      Kip.Eval
      Kip.MorphCache
      Kip.Parser
      Kip.Primitive
      Kip.Playground
      Kip.Render
      Kip.Runner
      Kip.Codegen.JS
      Kip.TypeCheck
      Language.Foma
  other-modules:
      Kip.Util
      Paths_kip
  autogen-modules:
      Paths_kip
  hs-source-dirs:
      src
  ghc-options: -O2
  c-sources:
      c/morphology.c
  include-dirs:
      c
  install-includes:
      morphology.h
  extra-libraries:
      foma
    , z
  if !os(windows) && !os(wasi)
    build-depends: unix
  if os(windows) || os(wasi)
    build-depends: time
  build-depends:
      base >=4.7 && <5
    , bytestring
    , containers
    , hashtables
    , unordered-containers
    , megaparsec

    , text
    , transformers
    , binary
    , cryptohash-sha256
    , mtl
    , filepath
    , directory
    , random
    , vector

executable kip
  import: kip-component
  main-is: Main.hs
  other-modules:
      Paths_kip
      Repl.Steps
  autogen-modules:
      Paths_kip
  hs-source-dirs:
      app
  ghc-options: -O2 -threaded -rtsopts "-with-rtsopts=-N4 -A32m"
  if os(wasi)
    buildable: False
  if !os(windows) && !os(wasi)
    cpp-options: -DHAVE_UNIX_EXIT
    build-depends: unix
  build-depends:
      base >=4.7 && <5
    , containers
    , directory
    , haskeline
    , optparse-applicative
    , transformers
    , megaparsec

    , kip
    , chalk
    , text
    , filepath
    , mtl
  default-extensions: CPP

executable kip-playground
  import: kip-component
  main-is: Playground.hs
  other-modules:
      Paths_kip
  autogen-modules:
      Paths_kip
  hs-source-dirs:
      app
  if os(wasi)
    ghc-options: -rtsopts
  else
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N -A64m"
  build-depends:
      base >=4.7 && <5
    , optparse-applicative
    , kip
    , text

executable kip-playground-reactor
  import: kip-component
  main-is: PlaygroundReactor.hs
  other-modules:
      Paths_kip
  autogen-modules:
      Paths_kip
  hs-source-dirs:
      app
  if os(wasi)
    ghc-options:
      -rtsopts
      -no-hs-main
      -optl-mexec-model=reactor
      -optl-Wl,--export=kip_run
      -optl-Wl,--export=hs_init
  else
    buildable: False
  build-depends:
      base >=4.7 && <5
    , kip
    , text

executable kip-lsp
  import: kip-component
  main-is: Lsp.hs
  other-modules:
      Lsp.TextDocument
      Paths_kip
  autogen-modules:
      Paths_kip
  hs-source-dirs:
      app
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N -A64m"
  if os(wasi)
    buildable: False
  build-depends:
      base >=4.7 && <5
    , containers
    , directory
    , filepath
    , hashtables
    , unordered-containers
    , kip
    , lens
    , lsp >=2.3
    , lsp-types >=2.3
    , megaparsec

    , text
    , cryptohash-sha256
    , mtl
    , vector

test-suite kip-tests
  import: kip-component
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      LspProtocol
      LspTest
  hs-source-dirs:
      tests
  build-depends:
      base >=4.7 && <5
    , aeson
    , bytestring
    , directory
    , filepath
    , process
    , scientific
    , tasty
    , tasty-hunit
    , text
    , time
    , vector
