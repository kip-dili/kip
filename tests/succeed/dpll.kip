Bir cümle
ya bir tam-sayı listesinin durumu
olabilir.

(bu tam-sayının) işaret-tersi,
  0'la bunun farkıdır.

(bu tam-sayıyla) (şu tam-sayının) eşit-değilliği,
  (bunla şunun eşitliğinin) tersidir.

(bu tam-sayı listesinin) (a tam-sayısını) içermesi,
  bu boşsa,
    yanlış;
  ilkin devama ekiyse,
    (ilkle a'nın eşitliği) doğruysa,
      doğru;
    değilse,
      devamın a'yı içermesidir.

(bu tam-sayı listesinden) (a tam-sayısının) ayıklanması,
  bunun (a'nın eşit-değilliğiyle) filtresidir.

(bu cümlenin) (a tam-sayısıyla) ayıklanmış-cümle-olasılığı,
  bu sayıların durumuysa,
    (sayıların a'yı içermesi) doğruysa,
      yokluk;
    değilse,
      ((sayıların (a'nın işaret-tersinin) ayıklanmasının) durumu) varlığıdır.

(bu cümle listesinden) (a tam-sayısının) ayıklanması,
  bu boşsa,
    boş;
  ilkin devama ekiyse,
    (ilkin a'yla ayıklanmış-cümle-olasılığı)
      yokluksa,
        devamdan a'nın ayıklanmasıdır;
      kalan-cümlenin varlığıysa,
        kalan-cümlenin (devamdan a'nın ayıklanmasına) ekidir.

(bu cümlenin) boş-cümleliği,
  bu sayıların durumuysa,
    sayılar boşsa,
      doğru;
    değilse,
      yanlıştır.

(bu cümlenin) birimi,
  bu sayıların durumuysa,
    sayılar boşsa,
      yokluk;
    ilk boşa ekiyse,
      ilkin varlığı;
    ilkin devama ekiyse,
      yokluktur.

(bu cümle listesinin) birimi,
  bu boşsa,
    yokluk;
  ilkin devama ekiyse,
    (ilkin birimi)
      sayının varlığıysa,
        sayının varlığı;
      yokluksa,
        devamın birimidir.

(bu cümlenin) (a tam-sayısını) içermesi,
  bu sayıların durumuysa,
    sayıların a'yı içermesidir.

(bu cümle listesinin) (a tam-sayısını) içermesi,
  bu boşsa,
    yanlış;
  ilkin devama ekiyse,
    (ilkin a'yı içermesi) doğruysa,
      doğru;
    değilse,
      devamın a'yı içermesidir.

(bu cümle listesinde) (a tam-sayısının) karşıtının-yokluğu,
  (bunun (a'nın işaret-tersini) içermesi) doğruysa,
    yanlış;
  değilse,
    doğrudur.

(bu tam-sayı listesinin) (bütün-cümleler cümle listesiyle) karşıtı-yokluğu-seçimi,
  bu boşsa,
    yokluk;
  ilkin devama ekiyse,
    ((bütün-cümlelerde ilkin karşıtının-yokluğu) doğruysa,
      ilkin varlığı;
    değilse,
      devamın bütün-cümlelerle karşıtı-yokluğu-seçimidir).

(bu cümlenin) (bütün-cümleler cümle listesiyle) karşıtı-yokluğu-seçimi,
  bu sayıların durumuysa,
    sayıların bütün-cümlelerle karşıtı-yokluğu-seçimidir.

(bu cümle listesinin) (bütün-cümleler cümle listesiyle) karşıtı-yokluğu-seçimi,
  bu boşsa,
    yokluk;
  ilkin devama ekiyse,
    (ilkin bütün-cümlelerle karşıtı-yokluğu-seçimi)
      sayının varlığıysa,
        sayının varlığı;
      yokluksa,
        devamın bütün-cümlelerle karşıtı-yokluğu-seçimidir.

(bu cümleden) seçim,
  bu sayıların durumuysa,
    sayılar boşsa,
      yokluk;
    ilk devama ekiyse,
      ilkin varlığıdır.

(bu cümle listesinden) seçim,
  bu boşsa,
    yokluk;
  ilk-cümlenin devama ekiyse,
    (ilk-cümleden seçim)
      sayının varlığıysa,
        sayının varlığı;
      yokluksa,
        devamdan seçimdir.

(bu cümle listesinin) (karar doğruluğu),
  (* Tüm cümleler tüketildiyse SAT. *)
  bu boşsa,
    doğru;
  değilse,
    (* Herhangi bir boş-cümle varsa çelişki oluştu UNSAT. *)
    (bunun boş-cümlelikle herhangisi) doğruysa,
      yanlış;
    değilse,
      (* unit propagation uygula (birim cümleyi zorunlu ata). *)
      (bunun birimi)
        a'nın varlığıysa,
          (bundan a'nın ayıklanmasının) kararı;
        yokluksa,
          (* pure literal elimination uygula. *)
          (bunun bununla karşıtı-yokluğu-seçimi)
            a'nın varlığıysa,
              (bundan a'nın ayıklanmasının) kararı;
            yokluksa,
              (* branching + backtracking (önce a, sonra ¬a). *)
              (bundan seçim)
                a'nın varlığıysa,
                  (((bundan a'nın ayıklanmasının) kararı) doğruysa,
                    doğru;
                  değilse,
                    ((bundan (a'nın işaret-tersinin) ayıklanmasının) kararı));
                yokluksa,
                  doğru.

(bu doğruluğun) metni,
  bu doğruysa,
    "SAT";
  yanlışsa,
    "UNSAT"tır.

(bu dizgenin) yorum-satırlığı,
  (bunun kelimeleri)
    ilk-kelimenin kalan-kelimelere ekiyse,
      (ilk-kelimeyle "c"nin eşitliğidir);
    boşsa,
      yanlıştır.
      
(bu dizgenin) problem-satırlığı,
  (bunun yorum-satırlığının) tersidir.

(bu dizge listesinin) yorumları-atılmışı,
  bunun problem-satırlığıyla filtresidir.

(bu dizge listesinin) kelimeleşmiş-hali,
  bu boşsa,
    boş;
  satırın devama ekiyse,
    ((satırın kelimeleriyle) (devamın kelimeleşmiş-halinin) birleşimidir).

(bu dizge listesinin) cnf-cümle-sayısı-sonrası,
  bu boşsa,
    yokluk;
  cümle-sayısının kalan-kelimelere ekiyse,
    ((cümle-sayısının tam-sayı-hali)
      yokluksa,
        yokluk;
      sayının varlığıysa,
        kalan-kelimelerin varlığı).

(bu dizge listesinin) cnf-değişken-sayısı-sonrası,
  bu boşsa,
    yokluk;
  değişken-sayısının kalan-kelimelere ekiyse,
    ((değişken-sayısının tam-sayı-hali)
      yokluksa,
        yokluk;
      sayının varlığıysa,
        kalan-kelimelerin cnf-cümle-sayısı-sonrasıdır).

(bu dizge listesinin) cnf-biçimi-sonrası,
  bu boşsa,
    yokluk;
  biçimin kalan-kelimelere ekiyse,
    (biçimle "cnf"nin eşitliği) doğruysa,
      kalan-kelimelerin cnf-değişken-sayısı-sonrasıdır;
    değilse,
      yokluktur.

(bu dizge listesinin) cnf-başlığı-sonrası,
  bu boşsa,
    yokluk;
  ilk-kelimenin kalan-kelimelere ekiyse,
    (ilk-kelimeyle "p"nin eşitliği) doğruysa,
      kalan-kelimelerin cnf-biçimi-sonrasıdır;
    değilse,
      yokluktur.

(bu cümlenin) (şu cümle listesinin) sonuna-eklenişi,
  (şunla (bunun boşa ekinin) birleşimidir).

(bu dizge listesinin) (literaller-tersi tam-sayı listesiyle) (birikmişler cümle listesiyle) cnf-cümle-birikimi,
  bu boşsa,
    (literaller-tersi boşsa,
      birikmişlerin varlığı;
    değilse,
      (literaller-tersinin tersine) yeni-cümle dersek,
      (((yeni-cümlenin durumunun) birikmişlerin sonuna-eklenişinin) varlığı));
  kelimenin kalan-kelimelere ekiyse,
    ((kelimenin tam-sayı-hali)
      yokluksa,
        yokluk;
      sayının varlığıysa,
        ((sayının 0'la eşitliği) doğruysa,
          (literaller-tersinin tersine) yeni-cümle dersek,
          (kalan-kelimelerin boşla ((yeni-cümlenin durumunun) birikmişlerin sonuna-eklenişiyle) cnf-cümle-birikimidir);
        değilse,
          (kalan-kelimelerin (sayının literaller-tersine ekiyle) birikmişlerle cnf-cümle-birikimidir))).

(bu dizgenin) cnf-cümleleri,
  (bunun satırlarına) satırlar dersek,
  (satırların yorumları-atılmışına) temiz-satırlar dersek,
  (temiz-satırların kelimeleşmiş-haline) kelimeler dersek,
  (kelimelerin cnf-başlığı-sonrası)
    yokluksa,
      yokluk;
    kalan-kelimelerin varlığıysa,
      kalan-kelimelerin boşla boşla cnf-cümle-birikimidir.
      
(dosya-adı dizgesinden) okuyup-çözmek,
  problem-cnf için dosya-adından okuyup,
    problem-cnf yokluksa,
      "DOSYA HATASI"yı yazmaktır;
    içeriğin varlığıysa,
      ((içeriğin cnf-cümleleri)
        yokluksa,
          "CNF HATASI"yı yazmaktır;
        cümlelerin varlığıysa,
          ((cümlelerin kararının) metnini) yazmaktır).

"./tests/succeed/dpll-basit.cnf"den okuyup-çöz.
"./tests/succeed/dpll-quinn.cnf"den okuyup-çöz.
"./tests/succeed/dpll-guvercin-yuvasi.cnf"den okuyup-çöz.
"./tests/succeed/dpll-uc-tum-kombinasyonlar.cnf"den okuyup-çöz.
