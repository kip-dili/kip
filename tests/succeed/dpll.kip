Bir cümle
ya bir tam-sayı listesinin durumu
olabilir.

(bu tam-sayının) işaret-tersi,
  0'la bunun farkıdır.

(bu tam-sayı listesinin) (x tam-sayısını) içermesi,
  bu boşsa,
    yanlış;
  ilkin devama ekiyse,
    (ilkle x'in eşitliği) doğruysa,
      doğru;
    değilse,
      devamın x'i içermesidir.

(bu tam-sayı listesinden) (x tam-sayısının) ayıklanması,
  bu boşsa,
    boş;
  ilkin devama ekiyse,
    (ilkle x'in eşitliği) doğruysa,
      devamdan x'in ayıklanmasıdır;
    değilse,
      ilkin (devamdan x'in ayıklanmasına) ekidir.

(bu cümlenin) (x tam-sayısıyla) ayıklanmış-cümle-olasılığı,
  bu sayıların durumuysa,
    (sayıların x'i içermesi) doğruysa,
      yokluk;
    değilse,
      ((sayıların (x'in işaret-tersinin) ayıklanmasının) durumu) varlığıdır.

(bu cümle listesinden) (x tam-sayısının) ayıklanması,
  bu boşsa,
    boş;
  ilkin devama ekiyse,
    (ilkin x'le ayıklanmış-cümle-olasılığı)
      yokluksa,
        devamdan x'in ayıklanmasıdır;
      kalan-cümlenin varlığıysa,
        kalan-cümlenin (devamdan x'in ayıklanmasına) ekidir.

(bu cümle listesinin) boş-cümle-içermesi,
  bu boşsa,
    yanlış;
  ilk-cümlenin devama ekiyse,
    (ilk-cümle)
      sayılar durumuysa,
        sayılar boşsa,
          doğru;
        değilse,
          devamın boş-cümle-içermesidir.

(bu cümlenin) birimi,
  bu sayıların durumuysa,
    sayılar boşsa,
      yokluk;
    ilk boşa ekiyse,
      ilkin varlığı;
    ilkin devama ekiyse,
      yokluktur.

(bu cümle listesinin) birimi,
  bu boşsa,
    yokluk;
  ilkin devama ekiyse,
    (ilkin birimi)
      sayının varlığıysa,
        sayının varlığı;
      yokluksa,
        devamın birimidir.

(bu cümlenin) (x tam-sayısını) içermesi,
  bu sayıların durumuysa,
    sayıların x'i içermesidir.

(bu cümle listesinin) (x tam-sayısını) içermesi,
  bu boşsa,
    yanlış;
  ilkin devama ekiyse,
    (ilkin x'i içermesi) doğruysa,
      doğru;
    değilse,
      devamın x'i içermesidir.

(bu cümle listesinde) (x tam-sayısının) karşıtının-yokluğu,
  (bunun (x'in işaret-tersini) içermesi) doğruysa,
    yanlış;
  değilse,
    doğrudur.

(bu tam-sayı listesinin) (bütün-cümleler cümle listesiyle) karşıtı-yokluğu-seçimi,
  bu boşsa,
    yokluk;
  ilkin devama ekiyse,
    ((bütün-cümlelerde ilkin karşıtının-yokluğu) doğruysa,
      ilkin varlığı;
    değilse,
      devamın bütün-cümlelerle karşıtı-yokluğu-seçimidir).

(bu cümlenin) (bütün-cümleler cümle listesiyle) karşıtı-yokluğu-seçimi,
  bu sayıların durumuysa,
    sayıların bütün-cümlelerle karşıtı-yokluğu-seçimidir.

(bu cümle listesinin) (bütün-cümleler cümle listesiyle) karşıtı-yokluğu-seçimi,
  bu boşsa,
    yokluk;
  ilkin devama ekiyse,
    (ilkin bütün-cümlelerle karşıtı-yokluğu-seçimi)
      sayının varlığıysa,
        sayının varlığı;
      yokluksa,
        devamın bütün-cümlelerle karşıtı-yokluğu-seçimidir.

(bu cümleden) seçim,
  bu sayıların durumuysa,
    sayılar boşsa,
      yokluk;
    ilk devama ekiyse,
      ilkin varlığıdır.

(bu cümle listesinden) seçim,
  bu boşsa,
    yokluk;
  ilk-cümlenin devama ekiyse,
    (ilk-cümleden seçim)
      sayının varlığıysa,
        sayının varlığı;
      yokluksa,
        devamdan seçimdir.

(bu cümle listesinin) (karar doğruluğu),
  bu boşsa,
    doğru;
  değilse,
    (bunun boş-cümle-içermesi) doğruysa,
      yanlış;
    değilse,
      (bunun birimi)
        x'in varlığıysa,
          (bundan x'in ayıklanmasının) kararı;
        yokluksa,
          (bunun bununla karşıtı-yokluğu-seçimi)
            x'in varlığıysa,
              (bundan x'in ayıklanmasının) kararı;
            yokluksa,
              (bundan seçim)
                x'in varlığıysa,
                  (((bundan x'in ayıklanmasının) kararı) doğruysa,
                    doğru;
                  değilse,
                    ((bundan (x'in işaret-tersinin) ayıklanmasının) kararı));
                yokluksa,
                  doğru.

(bu doğruluğun) metni,
  bu doğruysa,
    "SAT";
  yanlışsa,
    "UNSAT"tır.

basit-problem,
  durumuyla [
              [-1, 3]
            , [2, 3, -1]
            ]'in eşlemidir.
("basit-problem: "le ((basit-problem'in kararının) metninin) birleşimini) yaz.

quinn-problem,
  durumuyla [
              [1, 2]
            , [-2, -4]
            , [3, 4]
            , [-4, -5]
            , [5, -6]
            , [6, -7]
            , [6, 7]
            , [7, -16]
            , [8, -9]
            , [-8, -14]
            , [9, 10]
            , [9, -10]
            , [-10, -11]
            , [10, 12]
            , [11, 12]
            , [13, 14]
            , [14, -15]
            , [15, 16]
            ]'in eşlemidir.
("quinn-problem: "le ((quinn-problem'in kararının) metninin) birleşimini) yaz.

güvercin-yuvası-problemi,
  durumuyla [
              [1, 2]
            , [3, 4]
            , [5, 6]
            , [-1, -3]
            , [-1, -5]
            , [-3, -5]
            , [-2, -4]
            , [-2, -6]
            , [-4, -6]
            ]'in eşlemidir.
("güvercin-yuvası-problemi: "yle ((güvercin-yuvası-problemi'nin kararının) metninin) birleşimini) yaz.

üç-tüm-kombinasyonlar-problemi,
  durumuyla [
              [1, 2, 3]
            , [1, -2, -3]
            , [-1, 2, -3]
            , [-1, -2, 3]
            , [-1, -2, -3]
            , [-1, 2, 3]
            , [1, -2, 3]
            , [1, 2, -3]
            ]'in eşlemidir.
("üç-tüm-kombinasyonlar-problemi: "yle ((üç-tüm-kombinasyonlar-problemi'nin kararının) metninin) birleşimini) yaz.
