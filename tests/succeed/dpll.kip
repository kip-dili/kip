Bir cümle
ya bir tam-sayı listesinin durumu
olabilir.

(bu tam-sayının) işaret-tersi,
  0'la bunun farkıdır.

(bu tam-sayı listesinin) (x tam-sayısını) içermesi,
  bu boşsa,
    yanlış;
  ilkin devama ekiyse,
    (ilkle x'in eşitliği) doğruysa,
      doğru;
    değilse,
      devamın x'i içermesidir.

(bu tam-sayı listesinden) (x tam-sayısının) ayıklanması,
  bu boşsa,
    boş;
  ilkin devama ekiyse,
    (ilkle x'in eşitliği) doğruysa,
      devamdan x'in ayıklanmasıdır;
    değilse,
      ilkin (devamdan x'in ayıklanmasına) ekidir.

(bu cümlenin) (x tam-sayısıyla) ayıklanmış-cümle-olasılığı,
  bu sayıların durumuysa,
    (sayıların x'i içermesi) doğruysa,
      yokluk;
    değilse,
      ((sayıların (x'in işaret-tersinin) ayıklanmasının) durumu) varlığıdır.

(bu cümle listesinden) (x tam-sayısının) ayıklanması,
  bu boşsa,
    boş;
  ilkin devama ekiyse,
    (ilkin x'le ayıklanmış-cümle-olasılığı)
      yokluksa,
        devamdan x'in ayıklanmasıdır;
      kalan-cümlenin varlığıysa,
        kalan-cümlenin (devamdan x'in ayıklanmasına) ekidir.

(bu cümle listesinin) boş-cümle-içermesi,
  bu boşsa,
    yanlış;
  ilk-cümlenin devama ekiyse,
    (ilk-cümle)
      sayılar durumuysa,
        sayılar boşsa,
          doğru;
        değilse,
          devamın boş-cümle-içermesidir.

(bu cümlenin) birimi,
  bu sayıların durumuysa,
    sayılar boşsa,
      yokluk;
    ilk boşa ekiyse,
      ilkin varlığı;
    ilkin devama ekiyse,
      yokluktur.

(bu cümle listesinin) birimi,
  bu boşsa,
    yokluk;
  ilkin devama ekiyse,
    (ilkin birimi)
      sayının varlığıysa,
        sayının varlığı;
      yokluksa,
        devamın birimidir.

(bu cümlenin) (x tam-sayısını) içermesi,
  bu sayıların durumuysa,
    sayıların x'i içermesidir.

(bu cümle listesinin) (x tam-sayısını) içermesi,
  bu boşsa,
    yanlış;
  ilkin devama ekiyse,
    (ilkin x'i içermesi) doğruysa,
      doğru;
    değilse,
      devamın x'i içermesidir.

(bu cümle listesinde) (x tam-sayısının) karşıtının-yokluğu,
  (bunun (x'in işaret-tersini) içermesi) doğruysa,
    yanlış;
  değilse,
    doğrudur.

(bu tam-sayı listesinin) (bütün-cümleler cümle listesiyle) karşıtı-yokluğu-seçimi,
  bu boşsa,
    yokluk;
  ilkin devama ekiyse,
    ((bütün-cümlelerde ilkin karşıtının-yokluğu) doğruysa,
      ilkin varlığı;
    değilse,
      devamın bütün-cümlelerle karşıtı-yokluğu-seçimidir).

(bu cümlenin) (bütün-cümleler cümle listesiyle) karşıtı-yokluğu-seçimi,
  bu sayıların durumuysa,
    sayıların bütün-cümlelerle karşıtı-yokluğu-seçimidir.

(bu cümle listesinin) (bütün-cümleler cümle listesiyle) karşıtı-yokluğu-seçimi,
  bu boşsa,
    yokluk;
  ilkin devama ekiyse,
    (ilkin bütün-cümlelerle karşıtı-yokluğu-seçimi)
      sayının varlığıysa,
        sayının varlığı;
      yokluksa,
        devamın bütün-cümlelerle karşıtı-yokluğu-seçimidir.

(bu cümleden) seçim,
  bu sayıların durumuysa,
    sayılar boşsa,
      yokluk;
    ilk devama ekiyse,
      ilkin varlığıdır.

(bu cümle listesinden) seçim,
  bu boşsa,
    yokluk;
  ilk-cümlenin devama ekiyse,
    (ilk-cümleden seçim)
      sayının varlığıysa,
        sayının varlığı;
      yokluksa,
        devamdan seçimdir.

(bu cümle listesinin) (karar doğruluğu),
  bu boşsa,
    doğru;
  değilse,
    (bunun boş-cümle-içermesi) doğruysa,
      yanlış;
    değilse,
      (bunun birimi)
        x'in varlığıysa,
          (bundan x'in ayıklanmasının) kararı;
        yokluksa,
          (bunun bununla karşıtı-yokluğu-seçimi)
            x'in varlığıysa,
              (bundan x'in ayıklanmasının) kararı;
            yokluksa,
              (bundan seçim)
                x'in varlığıysa,
                  (((bundan x'in ayıklanmasının) kararı) doğruysa,
                    doğru;
                  değilse,
                    ((bundan (x'in işaret-tersinin) ayıklanmasının) kararı));
                yokluksa,
                  doğru.

(bu doğruluğun) metni,
  bu doğruysa,
    "SAT";
  yanlışsa,
    "UNSAT"tır.

basit-birinci-cümle, [-1, 3]'űn durumudur.
basit-ikinci-cümle, [2, 3, -1]'in durumudur.
basit-problem, [ 
                basit-birinci-cümle 
              , basit-ikinci-cümle
              ]'dir.
("basit-problem: "le ((basit-problem'in kararının) metninin) birleşimini) yaz.

quinn-birinci-cümle, [1, 2]'nin durumudur.
quinn-ikinci-cümle, [-2, -4]'ün durumudur.
quinn-üçüncü-cümle, [3, 4]'ün durumudur.
quinn-dördüncü-cümle, [-4, -5]'in durumudur.
quinn-beşinci-cümle, [5, -6]'nın durumudur.
quinn-altıncı-cümle, [6, -7]'nin durumudur.
quinn-yedinci-cümle, [6, 7]'nin durumudur.
quinn-sekizinci-cümle, [7, -16]'nın durumudur.
quinn-dokuzuncu-cümle, [8, -9]'un durumudur.
quinn-onuncu-cümle, [-8, -14]'ün durumudur.
quinn-onbirinci-cümle, [9, 10]'un durumudur.
quinn-onikinci-cümle, [9, -10]'un durumudur.
quinn-onüçüncü-cümle, [-10, -11]'in durumudur.
quinn-ondördüncü-cümle, [10, 12]'nin durumudur.
quinn-onbeşinci-cümle, [11, 12]'nin durumudur.
quinn-onaltıncı-cümle, [13, 14]'ün durumudur.
quinn-onyedinci-cümle, [14, -15]'in durumudur.
quinn-onsekizinci-cümle, [15, 16]'nın durumudur.
quinn-problem, [
                quinn-birinci-cümle
              , quinn-ikinci-cümle
              , quinn-üçüncü-cümle
              , quinn-dördüncü-cümle
              , quinn-beşinci-cümle
              , quinn-altıncı-cümle
              , quinn-yedinci-cümle
              , quinn-sekizinci-cümle
              , quinn-dokuzuncu-cümle
              , quinn-onuncu-cümle
              , quinn-onbirinci-cümle
              , quinn-onikinci-cümle
              , quinn-onüçüncü-cümle
              , quinn-ondördüncü-cümle
              , quinn-onbeşinci-cümle
              , quinn-onaltıncı-cümle
              , quinn-onyedinci-cümle
              , quinn-onsekizinci-cümle
              ]'dir.
("quinn-problem: "le ((quinn-problem'in kararının) metninin) birleşimini) yaz.

güvercin-yuvası-birinci-cümle, [1, 2]'nin durumudur.
güvercin-yuvası-ikinci-cümle, [3, 4]'ün durumudur.
güvercin-yuvası-üçüncü-cümle, [5, 6]'nın durumudur.
güvercin-yuvası-dördüncü-cümle, [-1, -3]'ün durumudur.
güvercin-yuvası-beşinci-cümle, [-1, -5]'in durumudur.
güvercin-yuvası-altıncı-cümle, [-3, -5]'in durumudur.
güvercin-yuvası-yedinci-cümle, [-2, -4]'ün durumudur.
güvercin-yuvası-sekizinci-cümle, [-2, -6]'nın durumudur.
güvercin-yuvası-dokuzuncu-cümle, [-4, -6]'nın durumudur.
güvercin-yuvası-problemi, [
                güvercin-yuvası-birinci-cümle
              , güvercin-yuvası-ikinci-cümle
              , güvercin-yuvası-üçüncü-cümle
              , güvercin-yuvası-dördüncü-cümle
              , güvercin-yuvası-beşinci-cümle
